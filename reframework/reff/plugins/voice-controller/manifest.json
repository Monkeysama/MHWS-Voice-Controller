{
  "manifestVersion": 1,
  "id": "voice-controller",
  "name": "Voice Controller",
  "localizedName": {"zh-CN": "音频控制器", "en-US": "Voice Controller"},
  "author": "MK",
  "version": "1.1.0",
  "reffApi": ">=0.1.0 <0.2.0",
  "games": ["MHWILDS"],
  "ui": {"kind": "page", "mode": "isolated-page", "entry": "ui/dist/index.html"},
  "methods": [
    "voice-controller.get-state",
    "voice-controller.save-event",
    "voice-controller.remove-saved-event",
    "voice-controller.update-saved-event-note",
    "voice-controller.play-event",
    "voice-controller.set-recent-lock",
    "voice-controller.add-group",
    "voice-controller.update-group",
    "voice-controller.update-blocked-sources",
    "voice-controller.remove-group",
    "voice-controller.add-rule-from-saved",
    "voice-controller.update-rule",
    "voice-controller.remove-rule",
    "voice-controller.add-candidate",
    "voice-controller.update-candidate",
    "voice-controller.remove-candidate",
    "voice-controller.test-candidate",
    "voice-controller.reload-config",
    "voice-controller.save"
  ],
  "events": ["voice-controller.changed"],
  "fallback": "none"
}
